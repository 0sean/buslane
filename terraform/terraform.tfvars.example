# Copy to terraform.tfvars and fill in values (never commit terraform.tfvars)

database_url          = "postgresql://user:password@host:5432/buslane_timetables"
api_key               = "your-api-key"
cloudflare_api_token  = "your-cloudflare-api-token"
cloudflare_account_id = "your-cloudflare-account-id"
cloudflare_zone_id    = "zone-id-for-transit.fyi"
gcp_project_id        = "your-gcp-project-id"
gcp_region            = "europe-west1"
sentry_dsn            = "https://xxx@oXXXX.ingest.sentry.io/XXXX"
timetables_image_tag  = "latest"
