<!DOCTYPE html>
<html>
  <head>
    <title><%= OasRails.config.info.title %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta charset="utf-8">
    <!-- Important: rapi-doc uses utf8 characters -->
  </head>
  <body>
    <%= yield %>
    <script>
        const rd = document.querySelector('rapi-doc');
        rd.addEventListener("spec-loaded", function() {
            const style = document.createElement('style');
            style.innerHTML = "#link-overview, #overview { display: none; }";
            rd.shadowRoot.appendChild(style);
        });
    </script>
  </body>
</html>