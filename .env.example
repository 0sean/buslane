# Keep database and scratch storage on the local USB SSD.
AUTH_KEY=replace-with-a-long-random-token
SENTRY_DSN=
TIMETABLES_DATA_DIR=./data
TIMETABLES_SCRATCH_DIR=./scratch
BUSLANE_UID=1000
BUSLANE_GID=1000
API_PORT=3000
TIMETABLES_WORKERS=2
TIMETABLES_CACHE_BYTES=33554432
MIN_FREE_BYTES=536870912
# Set registry tags after building ARM64 images off the Pi.
BUSLANE_API_IMAGE=buslane-api:local
BUSLANE_IMPORTER_IMAGE=buslane-importer:local
BUSLANE_FARES_IMAGE=buslane-fares:local
FARES_DATA_DIR=./data/fares
FARES_SCRATCH_DIR=./scratch/fares
FARES_WORKERS=1
FARES_CACHE_BYTES=8388608
