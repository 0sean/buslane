{
  "name": "@buslane/api",
  "type": "module",
  "scripts": {
    "build": "nitro build && bun run build:worker",
    "build:worker": "esbuild db/worker.ts db/fares/worker.ts --bundle --platform=node --format=esm --external:better-sqlite3 --external:drizzle-orm --external:drizzle-orm/* --outdir=.output/server/workers && mv .output/server/workers/worker.js .output/server/timetable-worker.mjs && mv .output/server/workers/fares/worker.js .output/server/fares-worker.mjs",
    "dev": "bun run build:worker && nitro dev",
    "preview": "node .output/server/index.mjs",
    "test": "bun run build && node --import tsx --test tests/*.test.ts",
    "check-types": "tsc --noEmit"
  },
  "imports": {
    "#*": "./*"
  },
  "devDependencies": {
    "jiti": "^2.6.1",
    "nitro": "latest",
    "typescript": "^6.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "esbuild": "^0.27.0",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "h3": "^2.0.1-rc.20",
    "better-sqlite3": "^12.10.0",
    "@sentry/node": "^10.49.0",
    "@buslane/timetable-db": "workspace:*"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
